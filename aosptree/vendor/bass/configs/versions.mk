# Versioning System For Bliss
# Bliss RELEASE VERSION
BASS_VERSION_MAJOR = 14
BASS_VERSION_MINOR = 0
BASS_CODENAME = Universe
#BASS_VERSION_MAINTENANCE = Beta

# Bliss Android version
BASS_VERSION_STATIC = 14.0
BASS_VERSION := $(BASS_VERSION_MAJOR).$(BASS_VERSION_MINOR)
#endif

TARGET_PRODUCT_SHORT := $(subst BASS_,,$(BASS_BUILDTYPE))

# Set BASS_BUILDTYPE
ifdef BASS_NIGHTLY
    BASS_BUILDTYPE := NIGHTLY
endif
ifdef BASS_EXPERIMENTAL
    BASS_BUILDTYPE := EXPERIMENTAL
endif
ifdef BASS_MAINTENANCE
   BASS_BUILDTYPE := MAINTENANCE
endif
# Set Unofficial if no buildtype set (Buildtype should ONLY be set by BLISS Devs!)
ifdef BASS_BUILDTYPE
else
    BASS_BUILDTYPE := UNOFFICIAL
endif

# See if RELEASE_OS_TITLE is defined, and if not, use the current title
ifeq ($(RELEASE_OS_TITLE),)
RELEASE_OS_TITLE := Bass
else
RELEASE_OS_TITLE := $(RELEASE_OS_TITLE)
endif

BASS_TYPE_NAME := $(RELEASE_OS_TITLE)$(BASS_SPECIAL_VARIANT)

# Set BLISS version
ifdef BASS_RELEASE
    BASS_BUILD_ZIP := $(BASS_TYPE_NAME)-v$(BASS_VERSION)
else
    BASS_BUILD_ZIP := $(BASS_TYPE_NAME)-v$(BASS_VERSION)-$(BASS_BUILDTYPE)-$(BASS_BUILD_VARIANT)-$(shell date +%Y%m%d%H)
endif

BASS_DEVICE := $(BASS_BUILD)
BASS_VERSION := $(BASS_VERSION)
BASS_DISPLAY_BUILDTYPE := $(BASS_BUILDTYPE)
BASS_FINGERPRINT := $(BASS_TYPE_NAME)/$(BASS_VERSION)/$(TARGET_PRODUCT_SHORT)/$(shell date +%Y%m%d%H%M)
BASS_BUILD_TIMESTAMP := $(shell date +%Y%m%d%H%M)
